APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SEARCH_PROVIDERS=rss,brave,tavily,google_cse,duckduckgo,openrouter
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=10
SEARCH_RETRIES=2
SEARCH_RETRY_BACKOFF_MS=200
SEARCH_RSS_FEEDS="https://feeds.bbci.co.uk/news/rss.xml"
SEARCH_USER_AGENT="NewsMonitor/1.0 (+https://example.com)"

BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
OPENROUTER_API_KEY=
OPENROUTER_SEARCH_MODEL=openrouter/auto:online

AI_PROVIDERS=openai,openrouter,anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_SEARCH_MODE=external
AI_MAX_TOKENS=1024
AI_TIMEOUT=30
AI_RETRIES=2
AI_RETRY_BACKOFF_MS=200
AI_ANALYZE_AFTER_SEARCH=true
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_USER_AGENT="NewsMonitor/1.0 (+https://example.com)"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# Scheduled search queue and concurrency
MONITORING_QUEUE_CONNECTION=
MONITORING_QUEUE=searches
MONITORING_QUEUE_TRIES=3
MONITORING_QUEUE_UNIQUE_FOR=3600
MONITORING_QUEUE_TIMEOUT=900
MONITORING_MAX_CONCURRENT_GLOBAL=5
MONITORING_MAX_CONCURRENT_PER_USER=2
MONITORING_CONCURRENCY_RELEASE_AFTER=30
MONITORING_COST_PER_RESULT=0
MONITORING_COST_PER_1K_TOKENS_AI=0

# Email notifications
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_DEFAULT_MODE=digest
NOTIFICATIONS_DIGEST_FREQUENCY=daily
NOTIFICATIONS_DIGEST_AT=8
NOTIFICATIONS_DIGEST_MAX_ITEMS=25
NOTIFICATIONS_MIN_RELEVANCE=0
NOTIFICATIONS_MAX_PER_DAY=20
NOTIFICATIONS_MAX_DIGEST_ITEMS=100
NOTIFICATIONS_QUEUE_CONNECTION=
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_QUEUE_TRIES=3
NOTIFICATIONS_QUEUE_UNIQUE_FOR=3600
NOTIFICATIONS_QUEUE_TIMEOUT=120

# Web push notifications (generate keys with "php artisan webpush:vapid")
WEBPUSH_ENABLED=true
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_PRIVACY_MODE=true
WEBPUSH_GENERIC_TITLE="New novedad"
WEBPUSH_GENERIC_BODY="You have a new novedad waiting."
WEBPUSH_TTL=3600
WEBPUSH_URGENCY=normal

VITE_APP_NAME="${APP_NAME}"
